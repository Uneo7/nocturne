{
	"name": "@nocturne/watercolour-showcase",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"description": "Showcase pages for the Nocturne watercolour graphics library, built on synthetic data",
	"scripts": {
		"dev": "vite dev --port 5181 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5181 --strictPort",
		"check": "svelte-kit sync && svelte-check-native --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260513.1",
		"bits-ui": "^2.18.1",
		"mode-watcher": "^1.1.0",
		"svelte": "5.55.5",
		"svelte-check-native": "^0.8.5",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.1",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@nocturne/ui": "workspace:*",
		"@nocturne/watercolour": "workspace:*"
	}
}
